# 本地环境变量示例。执行 `make setup` 会复制为 .env 并用随机值填充密钥。
# 所有变量覆盖 config/*.yaml 中的同名配置（嵌套键用下划线连接）。
APP_ENV=local
SERVICE_NAME=order-sys
CONFIG_FILE=config/local.example.yaml

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576
HTTP_SHUTDOWN_GRACE=15s

# 含密码，必须由环境注入；示例值仅供本地 compose 使用。
MYSQL_DSN=order:order@tcp(localhost:3306)/order_sys?parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=order-sys
ASYNQ_REDIS_ADDR=

LOG_LEVEL=info
OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1

# 由 make setup 生成随机值；不要提交真实密钥。
JWT_SECRET=
JWT_TTL=1h
PAYMENT_CALLBACK_TOKEN=

PAYMENT_TIMEOUT=15m
FLASH_SALE_QUEUE_TIMEOUT=5m
IDEMPOTENCY_TTL=24h
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_USER=100/min
LOCAL_AUTH_ENABLED=true
